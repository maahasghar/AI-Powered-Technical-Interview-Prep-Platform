{
  "compilerOptions": {
    "target": "es2017", "lib": ["dom", "esnext"], "module": "esnext",
    "moduleResolution": "node", "strict": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "react-jsx", "allowJs": true
  },
  "include": ["src"]
}
